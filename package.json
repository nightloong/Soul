{
  "name": "personaforge-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --configLoader runner",
    "preview": "vite preview --config apps/web/vite.config.ts --configLoader runner",
    "build": "tsc -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts --configLoader runner",
    "lint": "eslint apps/web/src",
    "test": "vitest run src --config apps/web/vite.config.ts --configLoader runner",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
